# Paths are relative to the repository root. Environment values override defaults.
PYTHON="${PYTHON:-python}"
DEVICE="${DEVICE:-cuda:0}"
SAPROT_DIR="${SAPROT_DIR:-data/weights/backbones/SaProt_650M_PDB}"
ERNIE_CHECKPOINT="${ERNIE_CHECKPOINT:-data/weights/backbones/ERNIE-RNA/ERNIE-RNA_pretrain.pt}"
ERNIE_CODE="${ERNIE_CODE:-data/weights/backbones/ERNIE-RNA/code}"
DATA_DIR="${DATA_DIR:-data/examples/training}"
EPOCHS="${EPOCHS:-1}"
BATCH_SIZE="${BATCH_SIZE:-2}"
SEED="${SEED:-42}"
LEARNING_RATE="${LEARNING_RATE:-0.00002}"
# Set PROTEIN_INIT="" to use SaProt initialization without PPI transfer.
PROTEIN_INIT="${PROTEIN_INIT-data/weights/ppi/ppi_full/weights.pt}"
OUTPUT="${OUTPUT:-data/runs/pri_demo}"
